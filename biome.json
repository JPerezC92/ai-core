{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    },
    "formatter": {
      "formatEmbeds": false,
      "proseWrap": "preserve"
    }
  },
  "overrides": [
    {
      "includes": ["odd/tasks/**/*.md"],
      "markdown": {
        "formatter": {
          "enabled": false
        }
      }
    }
  ],
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
